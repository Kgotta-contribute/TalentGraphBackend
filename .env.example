# Application Settings
APP_NAME=TalentAgent
AUTH_MODE=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend.vercel.app

# Database (Supabase PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Groq LLM (High-speed inference with multi-model failover)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embeddings (BAAI/bge-m3 via Hugging Face Serverless Inference)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
HF_TOKEN=your_huggingface_token_here

# GitHub API & MCP Client
GITHUB_TOKEN=github_pat_your_github_token
